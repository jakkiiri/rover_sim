<?xml version="1.0"?>
<!-- Local prototype CPU ray LiDAR for Gazebo Classic / gazebo_ros. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="rover_lidar" params="parent">
    <link name="lidar_link">
      <inertial>
        <mass value="0.15"/>
        <!-- Solid cylinder: radius .055 m, length .04 m, mass .15 kg. -->
        <inertia ixx="0.0001334375" ixy="0" ixz="0"
                 iyy="0.0001334375" iyz="0" izz="0.000226875"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.055" length="0.04"/></geometry>
        <material name="lidar_dark"><color rgba="0.12 0.15 0.18 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 -0.06"/>
        <geometry><cylinder radius="0.015" length="0.08"/></geometry>
        <material name="lidar_mount"><color rgba="0.45 0.45 0.45 1"/></material>
      </visual>
      <collision><geometry><cylinder radius="0.055" length="0.04"/></geometry></collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/><child link="lidar_link"/>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
    </joint>
    <!-- Gazebo may lump this fixed link into base_link. The sensor pose is
         retained; RSP still owns lidar_link TF from the original URDF. -->
    <gazebo reference="lidar_link">
      <material>Gazebo/Black</material>
      <sensor name="lidar" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
