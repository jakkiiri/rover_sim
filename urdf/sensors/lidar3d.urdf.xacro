<?xml version="1.0"?>
<!-- 3-D spinning LiDAR (VLP-16-like) on the instrument mast for Gazebo Classic.

     Profiles (xacro arg lidar_profile):
       lite     16 channels x 450 samples, 10 Hz   (default; measured cheapest)
       standard 16 channels x 900 samples, 10 Hz
       high     32 channels x 1024 samples, 10 Hz  (GPU recommended)
       dense    64 channels x 1024 samples, 10 Hz  (GPU only; near-continuous coverage)
     gpu="true" uses the gpu_ray sensor (needs a display/OpenGL), otherwise
     the CPU ray sensor. Both use libgazebo_ros_ray_sensor.so publishing
     sensor_msgs/PointCloud2 on /points_raw; rover_sim's lidar_postprocess
     node adds ring/time fields, dropout and range-dependent noise on /points. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="rover_lidar3d" params="parent xyz profile gpu channels:='' samples:='' vfov_deg:='' max_range:=100.0 backend:='classic'">
    <xacro:property name="lidar_channels" value="${int(channels) if str(channels) else (64 if profile == 'dense' else (32 if profile == 'high' else 16))}"/>
    <xacro:property name="lidar_samples" value="${int(samples) if str(samples) else (1024 if profile in ('high', 'dense') else (900 if profile == 'standard' else 450))}"/>
    <xacro:property name="lidar_vfov" value="${radians(float(vfov_deg)) if str(vfov_deg) else (radians(45.0) if profile in ('high', 'dense') else radians(30.0))}"/>
    <xacro:property name="lidar_type" value="${'gpu_ray' if str(gpu).lower() in ('true', '1') else 'ray'}"/>
    <link name="lidar_link">
      <inertial>
        <mass value="0.8"/>
        <origin xyz="0 0 0"/>
        <!-- Solid cylinder r = 0.055 m, h = 0.07 m -->
        <inertia ixx="0.00093" ixy="0" ixz="0" iyy="0.00093" iyz="0" izz="0.00121"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.055" length="0.07"/></geometry>
        <material name="lidar_dark"><color rgba="0.12 0.15 0.18 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 -0.045"/>
        <geometry><cylinder radius="0.02" length="0.02"/></geometry>
        <material name="lidar_mount"><color rgba="0.45 0.45 0.45 1"/></material>
      </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/><child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="lidar_link">
      <material>Gazebo/Black</material>
      <sensor name="lidar3d" type="${'gpu_lidar' if backend == 'fortress' else lidar_type}">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <xacro:if value="${backend == 'fortress'}">
          <!-- gz-sim gpu_lidar: exact beam labels, so no extra beam/shift is needed -->
          <topic>points_raw</topic>
          <ignition_frame_id>lidar_link</ignition_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>${lidar_samples}</samples><resolution>1</resolution>
                <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
              </horizontal>
              <vertical>
                <samples>${lidar_channels}</samples><resolution>1</resolution>
                <min_angle>${-lidar_vfov/2 if lidar_channels > 1 else 0.0}</min_angle><max_angle>${lidar_vfov/2 if lidar_channels > 1 else 0.0}</max_angle>
              </vertical>
            </scan>
            <range><min>0.5</min><max>${max_range}</max><resolution>0.002</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
          </lidar>
        </xacro:if>
        <xacro:if value="${backend == 'classic'}">
        <ray>
          <scan>
            <horizontal>
              <samples>${lidar_samples}</samples><resolution>1</resolution>
              <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
            </horizontal>
            <!-- gpu_ray: gazebo_ros_ray_sensor labels every point one vertical
                 step too low (measured 1.00 steps on 16 and 32 channels), so the
                 GPU variant requests one extra beam below the FOV and the
                 post-processor shifts the labels back and drops the top one. -->
            <vertical>
              <samples>${lidar_channels + (1 if (lidar_type == 'gpu_ray' and lidar_channels > 1) else 0)}</samples><resolution>1</resolution>
              <min_angle>${(-lidar_vfov/2 - (lidar_vfov/(lidar_channels-1) if lidar_type == 'gpu_ray' else 0.0)) if lidar_channels > 1 else 0.0}</min_angle><max_angle>${lidar_vfov/2 if lidar_channels > 1 else 0.0}</max_angle>
            </vertical>
          </scan>
          <range><min>0.5</min><max>${max_range}</max><resolution>0.002</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </ray>
        <plugin name="lidar3d_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/points_raw</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
        </xacro:if>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
