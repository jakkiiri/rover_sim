<?xml version="1.0"?>
<!-- LOCALLY MODIFIED by rover_sim from Kettenhoax/gazebo_ros_four_wheel_steering,
     commit 9802a276510915126a706df640cb90c42d1b2788 (Apache-2.0).
     Changes: relative include, centered steering inertia, continuous kingpins,
     effort/velocity limits and passive dynamics. See THIRD_PARTY_NOTICES.md
     for the complete change list. This notice was added in Phase 4.5. -->
<robot
    xmlns:xacro="http://ros.org/wiki/xacro"
    name="wheel_steered">
  <xacro:include filename="primitives.urdf.xacro" />
  <xacro:property
      name="axle_link_radius"
      value="0.1" />
  <xacro:property
      name="steering_link_mass"
      value="10.0" />

  <xacro:macro
      name="wheel_steered"
      params="prefix parent_link left_right *origin">
    <link name="${prefix}_axle">
      <xacro:sphere_primitive radius="${axle_link_radius}" />
      <xacro:sphere_inertial_with_origin
          radius="${axle_link_radius}"
          mass="${steering_link_mass}">
        <origin xyz="0 0 0" />
      </xacro:sphere_inertial_with_origin>
    </link>

    <joint
        name="${prefix}_kingpin"
        type="continuous">
      <limit
          effort="25"
          velocity="3.0" />
      <axis xyz="0 0 1" />
      <parent link="${parent_link}" />
      <child link="${prefix}_axle" />
      <xacro:insert_block name="origin" />
      <dynamics friction="0.02" damping="0.1" />
      <gazebo>
        <physics>
          <ode>
            <cfm_damping>1</cfm_damping>
          </ode>
        </physics>
      </gazebo>
    </joint>
  </xacro:macro>
</robot>
