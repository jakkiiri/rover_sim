<?xml version="1.0"?>
<!-- Sprung swerve module: body -> prismatic suspension -> strut -> continuous
     kingpin -> axle fork -> continuous wheel joint -> wheel.
     The steering axis stays vertical for every suspension position, which
     keeps module positions constant for the kinematics (docs/suspension.md). -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="swerve_module" params="prefix x y side">
    <!-- Suspension: strut travels vertically relative to the body. -->
    <link name="${prefix}_strut">
      <visual>
        <origin xyz="0 0 ${-strut_length/2}"/>
        <geometry><cylinder radius="0.025" length="${strut_length}"/></geometry>
        <material name="strut_grey"><color rgba="0.55 0.55 0.58 1"/></material>
      </visual>
      <!-- Inertia of a 0.10 m cube rather than the thin visual: ODE needs
           comparable inertias along a chain of jointed links. -->
      <xacro:inertial_box mass="${strut_mass}" x="${strut_inertia_size}" y="${strut_inertia_size}" z="${strut_inertia_size}">
        <origin xyz="0 0 ${-strut_length/2}"/>
      </xacro:inertial_box>
    </link>
    <xacro:if value="${suspension_mode == 'rigid'}">
      <joint name="${prefix}_suspension" type="fixed">
        <parent link="base_link"/>
        <child link="${prefix}_strut"/>
        <origin xyz="${x} ${y} ${-body_height/2}"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${suspension_mode == 'rigid'}">
      <joint name="${prefix}_suspension" type="prismatic">
        <parent link="base_link"/>
        <child link="${prefix}_strut"/>
        <origin xyz="${x} ${y} ${-body_height/2}"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-suspension_travel}" upper="${suspension_travel}" effort="2000" velocity="3.0"/>
        <dynamics damping="${suspension_damping}" friction="0.0"/>
      </joint>
      <xacro:if value="${suspension_mode == 'spring'}">
        <gazebo reference="${prefix}_suspension">
          <springStiffness>${suspension_stiffness}</springStiffness>
          <springReference>${suspension_reference}</springReference>
          <implicitSpringDamper>true</implicitSpringDamper>
          <provideFeedback>true</provideFeedback>
        </gazebo>
      </xacro:if>
    </xacro:unless>
    <gazebo reference="${prefix}_strut"><material>Gazebo/Grey</material></gazebo>

    <!-- Steering: the axle fork rotates about the vertical kingpin. -->
    <link name="${prefix}_axle">
      <visual>
        <origin xyz="0 ${side*fork_offset} ${-fork_drop/2}"/>
        <geometry><box size="0.06 0.03 ${fork_drop}"/></geometry>
        <material name="fork_dark"><color rgba="0.25 0.25 0.28 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 -0.01"/>
        <geometry><box size="0.08 ${2*fork_offset+0.03} 0.03"/></geometry>
        <material name="fork_dark"><color rgba="0.25 0.25 0.28 1"/></material>
      </visual>
      <xacro:inertial_box mass="${axle_mass}" x="0.08" y="${2*fork_offset+0.03}" z="${fork_drop}">
        <origin xyz="0 0 ${-fork_drop/2}"/>
      </xacro:inertial_box>
    </link>
    <joint name="${prefix}_kingpin" type="continuous">
      <parent link="${prefix}_strut"/>
      <child link="${prefix}_axle"/>
      <origin xyz="0 0 ${-strut_length}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${steering_torque}" velocity="${steering_rate}"/>
      <dynamics damping="0.1" friction="0.02"/>
    </joint>
    <gazebo reference="${prefix}_axle"><material>Gazebo/DarkGrey</material></gazebo>

    <!-- Wheel: visual tyre with grousers, collision selected by wheel_collision. -->
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="${wheel_radius*0.55}" length="${wheel_width+0.004}"/></geometry>
        <material name="hub"><color rgba="0.75 0.72 0.65 1"/></material>
      </visual>
      <xacro:grousers count="${grouser_count}" index="0"/>
      <xacro:if value="${wheel_collision == 'sphere'}">
        <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
      </xacro:if>
      <xacro:if value="${wheel_collision == 'multisphere'}">
        <collision><origin xyz="0 0 ${-wheel_width/3}"/><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
        <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
        <collision><origin xyz="0 0 ${wheel_width/3}"/><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
      </xacro:if>
      <xacro:if value="${wheel_collision == 'cylinder'}">
        <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      </xacro:if>
      <xacro:if value="${wheel_collision == 'band'}">
        <collision><geometry><cylinder radius="${wheel_radius}" length="0.02"/></geometry></collision>
      </xacro:if>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_axle"/>
      <child link="${prefix}_wheel"/>
      <!-- Cylinder axis (local Z) becomes the lateral (-Y) axle: forward
           rolling is a negative joint rate, as the kinematics derive. -->
      <origin xyz="0 0 ${-fork_drop}" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="${wheel_stall_torque}" velocity="${wheel_no_load_speed}"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>${wheel_mu}</mu1><mu2>${wheel_mu}</mu2>
      <kp>${wheel_kp}</kp><kd>${wheel_kd}</kd>
      <minDepth>${wheel_min_depth}</minDepth><maxVel>${wheel_max_vel}</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- Visual-only grousers (cleats) around the tyre, recursive xacro loop. -->
  <xacro:macro name="grousers" params="count index">
    <xacro:if value="${count > index}">
      <visual>
        <origin xyz="${wheel_radius*cos(2*pi*index/count)} ${wheel_radius*sin(2*pi*index/count)} 0"
                rpy="0 0 ${2*pi*index/count}"/>
        <geometry><box size="0.012 0.03 ${wheel_width*0.9}"/></geometry>
        <material name="grouser"><color rgba="0.35 0.33 0.30 1"/></material>
      </visual>
      <xacro:grousers count="${count}" index="${index+1}"/>
    </xacro:if>
  </xacro:macro>
</robot>
