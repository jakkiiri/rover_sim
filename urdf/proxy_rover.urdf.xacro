<?xml version="1.0"?>
<!-- Local assembly using the upstream steering and primitive macros.
     Provenance and changes: THIRD_PARTY_NOTICES.md. Dimensions are metres. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="proxy_rover">
  <xacro:arg name="enable_control" default="true"/>
  <xacro:arg name="actuator_watchdog" default="0.3"/>
  <xacro:arg name="enable_lidar" default="true"/>
  <!-- Preserve direct-Xacro 2D compatibility; the operator launch selects 3D. -->
  <xacro:arg name="lidar_mode" default="2d"/>
  <xacro:arg name="lidar_profile" default="lite"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <xacro:arg name="lidar_range" default="100.0"/>
  <xacro:arg name="lidar_samples" default=""/>
  <!-- Stereo camera (independent of the LiDAR switch); see docs/stereo.md. -->
  <xacro:arg name="enable_stereo" default="true"/>
  <!-- 480x360 RGB = 518,400 B per frame fits Fast DDS's default 512 KiB shared-memory
       segment; larger frames measurably delayed the controller reset handshake. -->
  <xacro:arg name="stereo_width" default="480"/>
  <xacro:arg name="stereo_height" default="360"/>
  <xacro:arg name="stereo_rate" default="15"/>
  <xacro:arg name="stereo_baseline" default="0.12"/>
  <xacro:arg name="stereo_hfov" default="1.5707963267948966"/>
  <xacro:arg name="stereo_xyz" default="0.52 0 -0.03"/>
  <xacro:arg name="stereo_rpy" default="0 0 0"/>
  <!-- LiDAR keep-out (base_link metres / degrees). Defaults fit the 2D LiDAR;
       rover_desert.launch.py passes the 3D LiDAR's mount and beam band. -->
  <xacro:arg name="lidar_keepout_origin" default="0 0 0.20"/>
  <xacro:arg name="lidar_keepout_vfov_min" default="-15"/>
  <xacro:arg name="lidar_keepout_vfov_max" default="15"/>
  <xacro:arg name="lidar_keepout_margin" default="2"/>
  <xacro:arg name="lidar_keepout_radius" default="0.15"/>
  <xacro:arg name="lidar_keepout_band" default="true"/>
  <!-- Ground-truth pose for the A* planner (rover_planner package). -->
  <xacro:arg name="ground_truth" default="true"/>
  <xacro:include filename="upstream/wheel_steered.urdf.xacro"/>
  <xacro:include filename="upstream/inertia_tensors.urdf.xacro"/>
  <xacro:include filename="sensors/lidar.urdf.xacro"/>
  <xacro:include filename="sensors/lidar3d.urdf.xacro"/>
  <xacro:include filename="sensors/stereo.urdf.xacro"/>
  <xacro:property name="axle_link_radius" value="0.06"/>
  <xacro:property name="steering_link_mass" value="1.0"/>
  <!-- Massless ROS root avoids the KDL root-inertia warning. -->
  <link name="base_root"/>
  <joint name="base_root_joint" type="fixed">
    <parent link="base_root"/><child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="base_link">
    <xacro:box_primitive x="1.0" y="0.5" z="0.2"/>
    <xacro:box_inertial x="1.0" y="0.5" z="0.2" mass="20"/>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Orange</material></gazebo>
  <xacro:macro name="wheel_module" params="prefix x side">
    <xacro:wheel_steered prefix="${prefix}" parent_link="base_link" left_right="${side}">
      <origin xyz="${x} ${side * 0.45} -0.15"/>
    </xacro:wheel_steered>
    <link name="${prefix}_wheel">
      <!-- Narrow centered tread approximates a rounded tire contact band.
           Full-width cylindrical collision edges cause turn scrub in ODE. -->
      <visual><geometry><cylinder length="0.12" radius="0.18"/></geometry></visual>
      <collision><geometry><cylinder length="0.02" radius="0.18"/></geometry></collision>
      <xacro:cylinder_inertial length="0.12" radius="0.18" mass="1"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_axle"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- Low passive drag; active control is provided by the Classic plugin. -->
      <dynamics damping="0.05" friction="0.02"/>
      <limit effort="40" velocity="20"/>
    </joint>
    <gazebo reference="${prefix}_axle"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
      <kp>1000000</kp><kd>100</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_module prefix="front_left" x="0.38" side="1"/>
  <xacro:wheel_module prefix="front_right" x="0.38" side="-1"/>
  <xacro:wheel_module prefix="rear_left" x="-0.38" side="1"/>
  <xacro:wheel_module prefix="rear_right" x="-0.38" side="-1"/>
  <xacro:if value="$(arg enable_lidar)">
    <xacro:if value="${'$(arg lidar_mode)' == '2d'}">
      <xacro:rover_lidar parent="base_link"/>
    </xacro:if>
    <xacro:if value="${'$(arg lidar_mode)' == '3d'}">
      <xacro:proxy_lidar3d parent="base_link" profile="$(arg lidar_profile)"
                           rate="$(arg lidar_rate)" max_range="$(arg lidar_range)"
                           samples="$(arg lidar_samples)"/>
    </xacro:if>
  </xacro:if>
  <xacro:if value="$(arg enable_stereo)">
    <xacro:rover_stereo parent="base_link" xyz="$(arg stereo_xyz)" rpy="$(arg stereo_rpy)"
                        width="$(arg stereo_width)" height="$(arg stereo_height)"
                        rate="$(arg stereo_rate)" baseline="$(arg stereo_baseline)" hfov="$(arg stereo_hfov)"
                        keepout_origin="$(arg lidar_keepout_origin)"
                        keepout_vfov_min="$(arg lidar_keepout_vfov_min)"
                        keepout_vfov_max="$(arg lidar_keepout_vfov_max)"
                        keepout_margin="$(arg lidar_keepout_margin)"
                        keepout_radius="$(arg lidar_keepout_radius)"
                        keepout_band="$(arg lidar_keepout_band)"/>
  </xacro:if>
  <xacro:if value="$(arg enable_control)">
    <gazebo>
      <plugin name="swerve_actuators" filename="librover_swerve_actuators.so">
        <watchdog_timeout>$(arg actuator_watchdog)</watchdog_timeout>
      </plugin>
    </gazebo>
  </xacro:if>
  <!-- Publishes the rover's exact pose in Gazebo's world frame as
       nav_msgs/Odometry on /ground_truth/odom. It adds no TF, sensor, mass or
       collision; rover_planner's ground_truth_odom node turns it into /odom
       and the odom -> base_root TF. Gazebo merges base_link into base_root
       (fixed joint, zero offset), so base_root is the body Gazebo knows. -->
  <xacro:if value="$(arg ground_truth)">
    <gazebo>
      <plugin name="ground_truth_pose" filename="libgazebo_ros_p3d.so">
        <ros><remapping>odom:=/ground_truth/odom</remapping></ros>
        <body_name>base_root</body_name>
        <frame_name>world</frame_name>
        <update_rate>50</update_rate>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
