Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud2 (3D LiDAR)1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 95; 95; 95
      Alpha: 0.3
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Frame Timeout: 15
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2 (3D LiDAR)
      Enabled: true
      Topic:
        Value: /points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Filter size: 10
      Style: Boxes
      Size (m): 0.05
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Use Fixed Frame: true
      Position Transformer: XYZ
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2 (raw sensor)
      Enabled: false
      Topic:
        Value: /points_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Alpha: 0.6
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 255; 120; 60
      Use Fixed Frame: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan, optional)
      Enabled: false
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.05
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 0; 255; 190
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Head Length: 0.1
        Head Radius: 0.05
        Color: 0; 200; 255
        Alpha: 1
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (ground truth)
      Enabled: false
      Topic:
        Value: /ground_truth/odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Head Length: 0.1
        Head Radius: 0.05
        Color: 255; 80; 80
        Alpha: 1
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Imu
      Name: Imu
      Enabled: false
      Topic:
        Value: /imu/data
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Enabled: true
  Global Options:
    Background Color: 24; 28; 34
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Current View
      Target Frame: base_link
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Near Clip Distance: 0.01
      Value: ThirdPersonFollower (rviz_default_plugins)
  Value: true
Window Geometry:
  Width: 1400
  Height: 900
  X: 50
  Y: 50
  Hide Left Dock: false
  Hide Right Dock: true
