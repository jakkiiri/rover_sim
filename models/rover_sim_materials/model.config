<?xml version="1.0"?>
<!-- Not a spawnable model: a resource folder so worlds can use
     model://rover_sim_materials/materials/... (see docs/stereo.md). -->
<model>
  <name>rover_sim_materials</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author><name>rover_sim</name></author>
  <description>Ground and rock materials for the stereo camera test features.</description>
</model>
