Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 95; 95; 95
      Alpha: 0.4
      Reference Frame: odom
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner grid
      Enabled: true
      Namespaces:
        planner_grid: true
      Topic:
        Value: /planner/grid_markers
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Planner grid (Map display)
      Enabled: false
      Topic:
        Value: /planner/grid
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Update Topic:
        Value: /planner/grid_updates
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: A* path
      Enabled: true
      Topic:
        Value: /planner/path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 0; 255; 120
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.06
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/PointCloud2
      Name: Stereo cloud
      Enabled: true
      Topic:
        Value: /stereo/points2
        Filter size: 10
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Alpha: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR 3D
      Enabled: true
      Topic:
        Value: /points
        Filter size: 10
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Size (m): 0.04
      Alpha: 1
      Color Transformer: AxisColor
      Color: 0; 255; 190
      Position Transformer: XYZ
      Decay Time: 0
      Use Fixed Frame: true
      Axis: Z
      Autocompute Value Bounds: true
    - Class: rviz_default_plugins/Image
      Name: Stereo left
      Enabled: true
      Topic:
        Value: /stereo/left/image_raw
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Stereo depth
      Enabled: true
      Topic:
        Value: /stereo/depth/image_raw
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Normalize Range: false
      Min Value: 0
      Max Value: 10
  Enabled: true
  Global Options:
    Background Color: 24; 28; 34
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 14
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: 3.14
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
  Value: true
Window Geometry:
  Width: 1400
  Height: 900
  X: 50
  Y: 50
  Hide Left Dock: false
  Hide Right Dock: true
