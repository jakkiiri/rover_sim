        <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
      </accessor></technique_common></source>
    <source id="nrm"><float_array id="nrm-a" count="18">0.00149 -0.04969 0.99876 -0.03035 -0.08116 0.99624 -0.06947 -0.11950 0.99040 -0.02222 -0.07332 0.99706 -0.06161 -0.11195 0.99180 -0.09213 -0.14191 0.98558</float_array>
      <technique_common><accessor source="#nrm-a" count="6" stride="3">
        <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
      </accessor></technique_common></source>
    <source id="uv"><float_array id="uv-a" count="12">15.00000 0.00000 15.50000 0.00000 16.00000 0.00000 15.00000 0.50000 15.50000 0.50000 16.00000 0.50000</float_array>
