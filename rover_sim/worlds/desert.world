<?xml version="1.0"?>
<!-- Gazebo Fortress world. Header blocks (physics, systems, GUI) come from
     rover_sim/fortress_world.py; test/test_fortress_worlds.py checks they match. -->
<sdf version="1.8">
  <world name="desert">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart><collision_detector>bullet</collision_detector></dart>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics">
      <engine><filename>ignition-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster">
      <state_hertz>30</state_hertz><dynamic_pose_hertz>30</dynamic_pose_hertz>
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <scene>
      <ambient>0.65 0.58 0.45 1</ambient>
      <background>0.70 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 0.94 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.6 0.55 0.5</ambient_light><background_color>0.70 0.82 0.92</background_color>
        <camera_pose>25 -30 24 0 0.55 2.2</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property>
          <property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property></ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">72</property>
          <property type="double" key="width">121</property><property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">110</property>
          <property type="double" key="width">290</property><property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui><property type="string" key="state">docked_collapsed</property></ignition-gui>
      </plugin>
      <!-- gz-sim's Teleop panel publishes ignition.msgs.Twist on /cmd_vel (bridged
           to ROS by the launch file). Tick "Keyboard" and hold W/A/S/D. -->
      <plugin filename="Teleop" name="Teleop">
        <ignition-gui><title>Rover teleop</title><property type="string" key="state">docked_collapsed</property></ignition-gui>
        <topic>/cmd_vel</topic>
      </plugin>
    </gui>

    <!-- Ground surface at z=0; no external models or textures required. -->
    <model name="sand_ground">
      <static>true</static>
      <pose>0 0 -0.25 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><box><size>100 100 0.5</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <!-- Visual only: textured sand gives stereo something to match. A mesh
             plane on the box top (z = 0) carries UVs that repeat every 8 m.
             Collision and friction are the box. -->
        <visual name="visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><mesh><uri>model://rover_sim_materials/meshes/sand_ground.obj</uri></mesh></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/rover_sand.png</albedo_map><roughness>0.95</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <!-- Buried spheres expose smooth spherical caps above the ground.
         Heights: 1.0, 1.5, 2.0 m; footprint diameters: 6.6, 9.3, 12 m.
         The origin remains flat for a future rover spawn. -->
    <model name="hill_west">
      <static>true</static>
      <pose>-10 3 -5 0 0 0</pose>
      <link name="hill">
        <collision name="collision">
          <geometry><sphere><radius>6</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>6</radius></sphere></geometry>
          <material>
            <ambient>0.76 0.62 0.39 1</ambient>
            <diffuse>0.86 0.72 0.47 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="hill_north">
      <static>true</static>
      <pose>0 13 -6.5 0 0 0</pose>
      <link name="hill">
        <collision name="collision">
          <geometry><sphere><radius>8</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>8</radius></sphere></geometry>
          <material>
            <ambient>0.76 0.62 0.39 1</ambient>
            <diffuse>0.86 0.72 0.47 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="hill_east">
      <static>true</static>
      <pose>12 2 -8 0 0 0</pose>
      <link name="hill">
        <collision name="collision">
          <geometry><sphere><radius>10</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>10</radius></sphere></geometry>
          <material>
            <ambient>0.76 0.62 0.39 1</ambient>
            <diffuse>0.86 0.72 0.47 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stereo test features (added for docs/stereo.md). Rules, checked by
         test/test_stereo_world.py:
         - static, unrotated boxes and vertical cylinders only; no spheres
           (validate_lidar.py treats every sphere collision as a hill);
         - at most 0.35 m tall, below the 2D LiDAR plane (~0.53 m above flat ground);
         - 3.5-6 m ahead of the spawn point, clear of the rover's validation
           motion area, the LiDAR validator's probe boxes and the hill footprints.
         Their collision makes them visible to a future 3D LiDAR, as real rocks would be.
         Pose = centre of the shape (metres); exact values are parsed by the validators. -->
    <model name="stereo_feature_crate">
      <static>true</static>
      <pose>4.5 0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.35</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/WoodPallet.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>
    <model name="stereo_feature_rock_slab">
      <static>true</static>
      <pose>4.5 1.4 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.25</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/granite.jpg</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>
    <model name="stereo_feature_brick_block">
      <static>true</static>
      <pose>3.6 -2.2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/bricks.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>
    <model name="stereo_feature_rock_post">
      <static>true</static>
      <pose>5.2 -1.6 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.3</length></cylinder></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/granite.jpg</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>
    <model name="stereo_feature_stump">
      <static>true</static>
      <pose>5.4 2.6 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>model://rover_sim_materials/materials/textures/WoodPallet.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
